# Copy to .env and change the password before exposing port 27017 anywhere.
MONGO_USER=sigmon
MONGO_PASSWORD=sigmon
MONGO_DB=signals
MONGO_PORT=27017

# sigmon.py reads these directly too, so `--mongo-uri` is usually unnecessary:
SIGMON_MONGO_URI=mongodb://sigmon:sigmon@127.0.0.1:27017/?authSource=admin
SIGMON_MONGO_DB=signals

# docker compose --profile ui up -d
MONGO_EXPRESS_USER=sigmon
MONGO_EXPRESS_PASSWORD=sigmon
MONGO_EXPRESS_PORT=8081
